[worldserver]

########################################
# mod-retail-ah
#
# Server half of the retail-style auction house. Players with the RetailAH addon get the
# Buy / Sell / Auctions window; everyone shares the same auctions as the stock window, AH bots
# and other modules.
########################################

#
#    RetailAH.Enable
#        Description: Master switch. With 0 the addon falls back to the stock auction window.
#        Default:     1
#

RetailAH.Enable = 1

#
#    RetailAH.MaxResults
#        Description: Most item groups one search returns. A search that finds more is cut off
#                     alphabetically and the window says so. Minimum 50.
#        Default:     500
#

RetailAH.MaxResults = 500

#
#    RetailAH.MaxDetailRows
#        Description: Most rows sent when a player opens one item: price tiers for a commodity,
#                     auctions for anything else. Minimum 50.
#        Default:     300
#

RetailAH.MaxDetailRows = 300

#
#    RetailAH.SearchCooldownMs
#        Description: Shortest time between two searches from one player, in milliseconds, on
#                     top of the per-character request budget (12 at once, 6 a second). Each
#                     search walks the whole auction house. 0 turns the extra gap off, which
#                     keeps searches instant: the server answers requests once per world tick,
#                     so a gap can refuse searches the player sent further apart than that.
#        Default:     0
#

RetailAH.SearchCooldownMs = 0

#
#    RetailAH.ReagentBank
#        Description: With mod-reagent-bank-account installed, let players post commodities
#                     straight from their reagent bank (after what's in their bags), and list the
#                     bank's contents on the Sell tab. Does nothing without that module.
#        Default:     1
#

RetailAH.ReagentBank = 1

#
#    RetailAH.Transmog
#        Description: With mod-transmog-plus installed, mark auctions whose appearance the
#                     player's account hasn't collected, and offer an "uncollected appearances
#                     only" search filter. Does nothing without that module.
#        Default:     1
#

RetailAH.Transmog = 1

#
#    RetailAH.BotPrice
#        Description: With mod-ah-bot-plus's buyer bot on (AuctionHouseBot.Buyer.Enabled), the
#                     Sell tab shows what the bot pays for the picked item and starts the price
#                     box at the most it pays every time it looks, so a post sells even with few
#                     players around. Worked out from the bot's own AuctionHouseBot.* options.
#                     Items vendors sell are left out: the bot only pays vendor price for those.
#        Default:     1
#

RetailAH.BotPrice = 1

#
#    RetailAH.Ledger
#        Description: Keep a gold ledger: every auction that ends for a player (sold, bought,
#                     expired, cancelled) is written to `mod_retail_ah_ledger` in the characters
#                     database, and the Ledger tab adds it up. The table is created at startup,
#                     so turning this on needs a restart. AH bot characters get no rows.
#        Default:     1
#

RetailAH.Ledger = 1

#
#    RetailAH.Ledger.KeepDays
#        Description: Ledger rows older than this are deleted at startup. 0 keeps them forever.
#        Default:     180
#

RetailAH.Ledger.KeepDays = 180

#
#    RetailAH.Ledger.MaxRows
#        Description: Most rows the Ledger tab gets at once (the newest, or the best items). The
#                     totals always cover the whole period. 50 to 2000.
#        Default:     300
#

RetailAH.Ledger.MaxRows = 300

#
#    RetailAH.CraftPrices
#        Description: Answer price lookups from the RetailProfessions addon (mod-retail-professions)
#                     anywhere, not only at an auctioneer: its profit view ranks the recipes a
#                     player knows by what the product sells for minus what the reagents cost.
#                     It gets the lowest buyout and units listed (the player's own auctions left
#                     out), what the AH bot buyer pays, vendor prices of reagents vendors sell, and
#                     how much sold in the last 14 days (from the ledger, kept in memory). Items
#                     the era gate hides get no prices unless the player owns one.
#        Default:     1
#

RetailAH.CraftPrices = 1

########################################
# What players see
#
# Two gates decide which auctions a player sees, in the retail window, in the classic window and
# for bids and buyouts from either. The Sell tab can still price items the player owns (bags,
# bank, reagent bank), but owning one never lets them buy more. GMs with GM mode on, and accounts matching
# mod-individual-progression's ExcludedAccountsRegex or BotAccountsRegex, see everything.
#
# `.rah item <id>` shows what holds an item back, `.rah player` what the selected player sees,
# `.rah reload` re-reads these options and rebuilds the era table.
#
# This replaces mod-ah-progression; remove that module. While its config is loaded, the classic
# window's search is left to it.
########################################

#
#    RetailAH.EraGate
#        Description: With mod-individual-progression, hide items the player's progression
#                     hasn't unlocked: no BWL, ZG, AQ, Naxx, Outland or Northrend items before the
#                     raid or expansion that brings them. Which state unlocks an item is worked
#                     out at startup from the world DB (see the README); rows in
#                     `mod_retail_ah_item_era` override it. Also follows IP's
#                     IndividualProgression.ProgressionLimit, .RequiredZulGurubProgression and
#                     .RequiredZulAmanProgression. Does nothing without IP.
#        Default:     1
#

RetailAH.EraGate = 1

#
#    RetailAH.EraGate.DeriveFromSources
#        Description: Work out each item's era from where it can be obtained (loot, vendors,
#                     quests, crafting). 0 = only the expansion floors below plus the override
#                     rows: TBC and WotLK items are hidden, but nothing inside vanilla is.
#        Default:     1
#

RetailAH.EraGate.DeriveFromSources = 1

#
#    RetailAH.EraGate.ExpansionFloors
#        Description: Treat items needing level 61+ as TBC and 71+ as WotLK (and gear with an
#                     item level past what vanilla or TBC had), whatever their sources say. Also
#                     gates crafts by skill tier: over 300 skill is TBC, over 375 is WotLK.
#                     Jewelcrafting, inscription, prospecting and milling are never gated as
#                     professions, only by these tiers.
#        Default:     1
#

RetailAH.EraGate.ExpansionFloors = 1

#
#    RetailAH.LevelGate
#        Description: Hide items needing a level more than RetailAH.LevelGate.Margin above the
#                     character's. Gear is judged by its required level. Items without one
#                     (trade goods, recipes, bags) by their item level, see .ItemLevel below.
#                     At the era's level cap (60 before TBC, 70 before WotLK, then the server's
#                     cap) the level gate steps aside and the era gate decides alone.
#        Default:     1
#

RetailAH.LevelGate = 1

#
#    RetailAH.LevelGate.Margin
#        Description: How many levels above the character an item may need and still show.
#        Default:     2
#

RetailAH.LevelGate.Margin = 2

#
#    RetailAH.LevelGate.ItemLevel
#        Description: Judge items without a required level by their item level. 0 = only items
#                     with a required level are level gated, so a level 10 sees Runecloth and
#                     Arcanite Bars.
#        Default:     1
#

RetailAH.LevelGate.ItemLevel = 1

#
#    RetailAH.Gates.ClassicWindow
#        Description: Filter the classic auction window's search through the same gates. Bids
#                     and buyouts on hidden auctions are refused either way.
#        Default:     1
#

RetailAH.Gates.ClassicWindow = 1
